# Example environment variables for the wedding website
# Copy this file to .env and fill in your actual values

# DEPRECATED: Simple password protection (Option 1)
# REACT_APP_ADMIN_PASSWORD=your-secure-password-here

# NOTE: Firebase Authentication is now used for admin access (Option 2)
# Configure admin emails in src/data/adminAuth.js
# No additional environment variables needed for Firebase Auth
# Firebase config is already set up in src/data/firebase.js

# To set up Firebase Authentication:
# 1. Go to Firebase Console > Authentication > Sign-in method
# 2. Enable "Email/Password" authentication
# 3. Add admin users in Authentication > Users tab
# 4. Update ADMIN_EMAILS array in src/data/adminAuth.js with your email addresses
